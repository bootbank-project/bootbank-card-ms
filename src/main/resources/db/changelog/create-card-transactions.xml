<changeSet id="create-card-transactions-table" author="nicat">
    <createTable tableName="card_transactions">
        <column name="id" type="BIGSERIAL">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="card_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>
        <column name="title" type="VARCHAR(100)">
            <constraints nullable="false"/>
        </column>
        <column name="category" type="VARCHAR(50)">
            <constraints nullable="false"/>
        </column>
        <column name="amount" type="NUMERIC(15,2)">
            <constraints nullable="false"/>
        </column>
        <column name="status" type="VARCHAR(20)">
            <constraints nullable="false"/>
        </column>
        <column name="created_at" type="TIMESTAMP">
            <constraints nullable="false"/>
        </column>
    </createTable>

    <!-- Foreign key əlaqəsi: card_transactions.card_id -> user_cards.id -->
    <addForeignKeyConstraint
            baseTableName="card_transactions"
            baseColumnNames="card_id"
            referencedTableName="user_cards"
            referencedColumnNames="id"
            constraintName="fk_card_transactions_user_cards"/>
</changeSet>
